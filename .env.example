# Copiar a .env y completar. NUNCA subir .env al repositorio.

# ── Base de datos ────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/ustudent
DB_USER=ustudent
DB_PASSWORD=cambiar_en_local

# ── Seguridad ────────────────────────────────────────────────────
# Generar el par con:
#   openssl genrsa -out secrets/jwt_private.pem 2048
#   openssl rsa -in secrets/jwt_private.pem -pubout -out secrets/jwt_public.pem
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_HOURS=8

# Clave AES-256 en base64 para cifrar campos sensibles.
# Generar con: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Clasificacion con IA ─────────────────────────────────────────
# Con AI_PROVIDER=rules el sistema funciona sin credenciales, usando el
# clasificador determinista de respaldo (ADR-0003).
AI_ENABLED=true
AI_PROVIDER=rules
AI_MODEL=claude-sonnet-5
AI_API_KEY=
AI_TIMEOUT_MS=5000
AI_MIN_CONFIDENCE=0.55

# ── Correo (Mailpit en local: http://localhost:8025) ─────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ustudent@usta.edu.co

# ── Adjuntos ─────────────────────────────────────────────────────
STORAGE_TYPE=filesystem
STORAGE_PATH=./attachments
STORAGE_MAX_FILE_MB=10
