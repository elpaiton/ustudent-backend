meta {
  name: Login con datos invalidos
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "esto-no-es-un-correo",
    "password": ""
  }
}

docs {
  Validacion de entrada. No llega a consultar la base de datos: lo rechaza
  la validacion del DTO.

  El detalle por campo es lo que el formulario del frontend usa para marcar
  el input concreto en vez de mostrar un error generico.
}

tests {
  test("responde 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("indica que campos fallaron", function() {
    expect(res.getBody().code).to.equal("VALIDATION_FAILED");
    expect(res.getBody().errors).to.be.an("array").that.is.not.empty;
  });
}
